{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 3,
  "items": {
    "type": "object",
    "required": ["id", "name", "location", "date", "mission", "status", "purpose", "story", "legacy", "evidence", "openQuestion", "theme", "sources"],
    "properties": {
      "id": {"type": "string"},
      "name": {"type": "string"},
      "location": {"enum": ["Moon", "Mars"]},
      "date": {"type": "string"},
      "mission": {"type": "string"},
      "status": {"type": "string"},
      "purpose": {"type": "string"},
      "story": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "legacy": {"type": "string"},
      "evidence": {"type": "array", "items": {
        "type": "object", "required": ["label", "text", "source"],
        "properties": {
          "label": {"enum": ["Confirmed finding", "Scientific interpretation", "Still unknown"]},
          "text": {"type": "string"},
          "source": {"type": "string"}
        }
      }},
      "openQuestion": {"type": "object", "required": ["prompt", "choices", "evidenceOptions"],
        "properties": {
          "prompt": {"type": "string"},
          "choices": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
          "evidenceOptions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      },
      "theme": {"type": "string"},
      "sources": {"type": "array", "items": {"type": "object", "required": ["title", "url"], "properties": {"title": {"type": "string"}, "url": {"type": "string"}}}}
    }
  }
}
